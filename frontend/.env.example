# API Configuration
# For local development, leaving these relative or empty works best with the Vite proxy
VITE_API_URL=/api/v1
VITE_WS_URL=

# App Configuration
VITE_APP_NAME=RealEstate AI
VITE_APP_VERSION=1.0.0

# Map Configuration
VITE_MAP_CENTER_LAT=45.070860
VITE_MAP_CENTER_LON=7.685588
VITE_MAP_DEFAULT_ZOOM=13

# Feature Flags
VITE_ENABLE_ANALYTICS=false
