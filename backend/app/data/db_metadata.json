  "_description": "Metadati del dataset immobili per gli agenti LLM. Include valori, statistiche e legende punteggi.",
  "score_legends": {
    "ape_scores": {
      "_description": "Punteggi di efficienza energetica derivati dai certificati APE. Scala 1-5 dove 5=ottimo.",
      "ape_score_classe": {
        "meaning": "Classe energetica certificata dell'edificio",
        "scale": "5=A1-A4 (alta efficienza), 3=B-E (media), 1=F-G (bassa efficienza)"
      },
      "ape_score_impianto": {
        "meaning": "Qualità e tipologia dell'impianto di riscaldamento/raffrescamento",
        "scale": "5=Pompa di calore/Teleriscaldamento, 3=Caldaia a condensazione/Biomassa, 1=Caldaia tradizionale"
      },
      "ape_score_involucro": {
        "meaning": "Qualità dell'isolamento termico dell'edificio (cappotto, infissi, copertura)",
        "scale": "5=Ottimo isolamento (cappotto + infissi), 3=Isolamento parziale, 1=Scarso o assente"
      },
      "ape_score_rinnovabili": {
        "meaning": "Presenza di impianti a fonti rinnovabili (fotovoltaico, solare termico)",
        "scale": "5=Presenti e certificati, 1=Assenti"
      },
      "ape_score_total": {
        "meaning": "Media ponderata dei 4 punteggi APE sopra",
        "scale": "5=Eccellente efficienza complessiva, 1=Scarsa efficienza"
      }
    },
    "poi_scores": {
      "_description": "Punteggi di prossimità ai servizi calcolati nel raggio di 1km. Scala 1-5 dove 5=eccellente copertura.",
      "interpretation": "1=Scarsa copertura, 2=Sufficiente, 3=Buona, 4=Ottima, 5=Eccellente",
      "sanita": {
        "meaning": "Vicinanza a servizi sanitari",
