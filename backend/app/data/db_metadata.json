        "includes": "Parchi pubblici, giardini, aree naturali protette, aiuole attrezzate"
      },
      "sport": {
        "meaning": "Vicinanza a impianti sportivi",
        "includes": "Palestre, piscine, campi sportivi, centri fitness, impianti comunali"
      },
      "commerciale": {
        "meaning": "Disponibilità di servizi commerciali",
