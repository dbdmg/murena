# App Configuration
APP_NAME=MURENA-API
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
WORKERS=4

# Database
DATABASE_URL=sqlite:///./data/database/users.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
SQL_ECHO=false
DATABASE_PATH=data/database/users.db
CACHE_DIR=data/database/cache

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-please-change-this-to-something-secure-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM APIs
# --- Provider selection ------------------------------------------------------
# LLM_PROVIDER: openai | gemini | anthropic (claude) | grok (xai) | ollama |
#               openai-compatible (vLLM / LM Studio / llama.cpp, on-premises)
# Leave empty to infer it from LLM_MODEL (claude-* -> anthropic, gemini-* ->
# gemini, grok-* -> grok, gpt-* -> openai, otherwise openai-compatible).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# Base URL for openai-compatible / ollama providers (on-premises open-weight
# models such as Gemma, gpt-oss, Qwen), e.g. http://localhost:8000/v1 (vLLM)
LLM_BASE_URL=
# Legacy alias of LLM_BASE_URL, still honoured:
OPENAI_API_BASE=

# --- Provider credentials (fill only the ones you use) ------------------------
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
INSTITUTIONAL_LLM_API_KEY=your-institutional-key-here

# --- Per-agent model overrides (optional) --------------------------------------
# Any agent can run on a different model, e.g.:
# AGENT_MODEL_SQL_AGENT=gpt-4o
# AGENT_MODEL_LOCATION_AGENT=gemma3:27b
# AGENT_MODEL_EVALUATION_AGENT=claude-sonnet-5

# --- Example configurations ----------------------------------------------------
# ChatGPT (OpenAI):    LLM_PROVIDER=openai            LLM_MODEL=gpt-4o
# Gemini:              LLM_PROVIDER=gemini            LLM_MODEL=gemini-3.5-flash
# Claude:              LLM_PROVIDER=anthropic         LLM_MODEL=claude-sonnet-5
# Grok:                LLM_PROVIDER=grok              LLM_MODEL=grok-4
# Ollama (local):      LLM_PROVIDER=ollama            LLM_MODEL=gemma3:27b
# vLLM (on-premises):  LLM_PROVIDER=openai-compatible LLM_MODEL=gpt-oss-120b LLM_BASE_URL=http://localhost:8000/v1

# External APIs
NOMINATIM_USER_AGENT=MURENA/1.0

# Base File Paths
DATA_DIR=data/datasets
STATIC_DIR=data/static_data
ENERGY_DIR=data/energy_data
META_DIR=data/metadata
RUNS_DIR=data/runs
AGENT_LOGS_DIR=data/agent_logs

# Energy Specific Paths
ENERGY_MATCH_DIR=data/energy_data/MATCH
PLOT_DIR=data/energy_data/metadata/plots_inverted

# Dataset Paths
DATASET_FULL=data/metadata/estates.parquet
IMMOBILI_MAPPING_PATH=notebooks/02_quotazione/mapping_immobili.csv
QIP_VALORI_PATH=notebooks/02_quotazione/QIP_1303437_1_20251_VALORI.csv
QIP_MAPPING_PATH=notebooks/02_quotazione/mapping_qip.csv
IMMOBILI_QUOTAZIONE_PATH=notebooks/02_quotazione/quotazione_immobili.csv
ZONE_GRUPPO_QUOTAZIONI_PATH=notebooks/02_quotazione/zone_gruppo_quotazioni.csv
MISSING_QUOTAZIONI_IDS_PATH=notebooks/02_quotazione/missing_quotazioni_ids.csv

# Geodata Paths
ZONE_OMI_PROVINCIA_TORINO_GEOJSON=data/static_data/zone_omi_provincia_torino.geojson.zip
ZONE_OMI_GEOJSON=data/static_data/omi_zones.geojson
ZONE_URBANISTICHE_GEOJSON=data/static_data/rome_urban_zones.geojson
MUNICIPI_GEOJSON=data/static_data/municipi.geojson
STATIONS_CSV=data/datasets/station_dataframe.csv

# Processing Configuration
APE_XML_PATH=data/xml
TARGET_CITY=Torino
TARGET_PROVINCE=TO
TARGET_COMUNE_CODE=L219
OSM_PBF_PATH=data/nord-ovest-latest.osm.pbf
POI_PATH=data/metadata/pois_by_category.json
DATABASE_PATH=data/FOLDER_DATABASE/users.db
CACHE_DIR=data/FOLDER_DATABASE/cache

# Experiment Results
RESULTS_ROOT=tests/results
EXPERIMENT_METADATA_DIR=experiments/data/metadata
