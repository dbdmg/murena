# App Configuration
APP_NAME=MEF-Immobili-API
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+psycopg2://mef_user:mef_password@localhost:5432/mef_immobili
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-please-change-this-to-something-secure-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM APIs (copy from your current .env)
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
LLM_POLITO_API_KEY=your-llm-polito-key-here

# External APIs
NOMINATIM_USER_AGENT=MEF-Immobili/1.0

# File Paths
DATA_DIR=../FOLDER_DATASET
STATIC_DIR=../FOLDER_STATIC_ROME
APE_DIR=../FOLDER_APE
META_DIR=../FOLDER_META
