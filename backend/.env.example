# App Configuration
APP_NAME=MURENA-API
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
WORKERS=4

# Database
DATABASE_URL=sqlite:///./data/database/users.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_PATH=data/database/users.db
CACHE_DIR=data/database/cache

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-please-change-this-to-something-secure-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM APIs
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
LLM_MODEL=gpt-5.4
OPENAI_API_BASE=https://api.openai.com/v1
INSTITUTIONAL_LLM_API_KEY=your-institutional-key-here

# External APIs
NOMINATIM_USER_AGENT=MURENA/1.0

# Base File Paths
DATA_DIR=data/datasets
STATIC_DIR=data/static_data
ENERGY_DIR=data/energy_data
META_DIR=data/metadata
RUNS_DIR=data/runs
AGENT_LOGS_DIR=data/agent_logs

# Energy Specific Paths
ENERGY_MATCH_DIR=data/energy_data/MATCH
PLOT_DIR=data/energy_data/metadata/plots_inverted

# Dataset Paths
DATASET_FULL=data/metadata/estates.parquet
IMMOBILI_MAPPING_PATH=notebooks/02_quotazione/mapping_immobili.csv
QIP_VALORI_PATH=notebooks/02_quotazione/QIP_1303437_1_20251_VALORI.csv
QIP_MAPPING_PATH=notebooks/02_quotazione/mapping_qip.csv
IMMOBILI_QUOTAZIONE_PATH=notebooks/02_quotazione/quotazione_immobili.csv
ZONE_GRUPPO_QUOTAZIONI_PATH=notebooks/02_quotazione/zone_gruppo_quotazioni.csv
MISSING_QUOTAZIONI_IDS_PATH=notebooks/02_quotazione/missing_quotazioni_ids.csv

# Geodata Paths
ZONE_OMI_PROVINCIA_TORINO_GEOJSON=data/static_data/zone_omi_provincia_torino.geojson.zip
ZONE_OMI_GEOJSON=data/static_data/omi_zones.geojson
ZONE_URBANISTICHE_GEOJSON=data/static_data/rome_urban_zones.geojson
MUNICIPI_GEOJSON=data/static_data/municipi.geojson
STATIONS_CSV=data/datasets/station_dataframe.csv
